# 멀티스테이지 빌드는 Docker 관점에서 전체 애플리케이션 환경을 최적화 하는 방법이다
# ===================
# 1단계: 빌드 스테이지 (빌드 스테이지에서는 개발도구와 빌드 환경이 포함된다)
# ===================
FROM node:18-alpine AS builder

# 작업 디렉토리 설정
WORKDIR /app

# 패키지 파일만 먼저 복사하고 의존성 설치 (캐시 최적화)
COPY package.json package-lock.json ./
RUN npm install

# 전체 프로젝트 복사
COPY . .

# Next.js 빌드 실행 (standalone 모드 활성화되어 있다고 가정)
RUN npm run build

# ===================
# 2단계: 실행 스테이지
# ===================
FROM node:18-alpine AS runner

WORKDIR /app

# 빌드 결과물만 복사 (불필요한 파일은 제외)
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/static ./.next/static

# 포트 노출
EXPOSE 3000

CMD ["node", "server.js"]